<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Dev-only, authorized ADB shell, read-only own-app diagnostics. -->
        <provider android:name=".RunnerSnapshotProvider"
            android:authorities="${applicationId}.runner"
            android:exported="true" android:permission="android.permission.DUMP"
            android:grantUriPermissions="false" />
        <activity android:name=".RunnerClipboardActivity"
            android:exported="true" android:permission="android.permission.DUMP"
            android:excludeFromRecents="true" android:noHistory="true" />
    </application>
</manifest>
